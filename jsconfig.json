{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "baseUrl": "./frontend/src",
    "forceConsistentCasingInFileNames": false,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true
  },
  "include": ["frontend/src/**/*"]
}
